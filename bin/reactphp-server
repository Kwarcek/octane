#!/usr/bin/env php
<?php

use Laravel\Octane\ReactPhp\ReactPhpClient;
use Laravel\Octane\RequestContext;
use Laravel\Octane\ApplicationFactory;
use Laravel\Octane\ReactPhp\ServerStateFile;
use Laravel\Octane\ReactPhp\WorkerState;
use React\EventLoop\Loop;
use React\Http\HttpServer;
use React\Http\Message\Response;
use React\Promise\Deferred;
use React\Socket\SocketServer;
use Psr\Http\Message\ServerRequestInterface;
use \Laravel\Octane\Worker;

ini_set('display_errors', 'stderr');

require_once __DIR__.'/../src/Stream.php';

require __DIR__.'/../fixes/fix-symfony-dd.php';

$bootstrap = fn ($serverState) => require __DIR__.'/bootstrap.php';

/*
|--------------------------------------------------------------------------
| Create The ReactPHP Server
|--------------------------------------------------------------------------
|
| First, we will load the server state file from disk. This file contains
| various information we need to boot ReactPHP such as the configuration
| and application name. We can use this data to start up our server.
|
*/

$serverState = json_decode(file_get_contents(
    $serverStateFile = $_SERVER['argv'][1]
), true)['state'];

/*
|--------------------------------------------------------------------------
| Create The HTTP Server
|--------------------------------------------------------------------------
|
| We will create a ReactPHP HTTP server that will handle incoming requests
| and route them to our Laravel application.
|
*/

$basePath = $bootstrap($serverState);

$workerState = new WorkerState;

$workerState->client = new ReactPhpClient;
$workerState->worker = new Worker(
    new ApplicationFactory($basePath), $workerState->client
);
$workerState->worker->boot();
$workerState->app = $workerState->worker->application();

$requestHandler = function (ServerRequestInterface $request) use ($workerState, $serverState) {
    $context = new RequestContext;
    $context->reactPhpRequest = $request;
    $context->reactPhpResponse = new Deferred;
    $context->octaneConfig = $serverState['octaneConfig'] ?? [];
    $context->publicPath = $serverState['publicPath'] ?? null;

    $illuminateRequest = null;

    try {
        [$illuminateRequest, $context] = $workerState->client->marshalRequest($context);

        $workerState->worker->handle($illuminateRequest, $context);

        return $context->reactPhpResponse->promise();
    } catch (Throwable $e) {
        $workerState->client->error(
            $e,
            $workerState->app,
            $illuminateRequest ?? \Illuminate\Http\Request::createFromGlobals(),
            $context
        );

        return $context->reactPhpResponse->promise();
    }
};

$server = new HttpServer($requestHandler);

$socket = new SocketServer($serverState['host'].':'.$serverState['port']);

$server->listen($socket);

$stateFile = new ServerStateFile($serverStateFile);
$serverState['pid'] = getmypid();
$stateFile->write($serverState);

echo "ReactPHP server started on {$serverState['host']}:{$serverState['port']}" . PHP_EOL;

/*
|--------------------------------------------------------------------------
| Signal Handling for Watch Mode
|--------------------------------------------------------------------------
|
| We will set up signal handlers to allow the server to be reloaded
| when file changes are detected. This enables the --watch functionality.
|
*/

$reloadApplication = function () use ($bootstrap, $serverState, $workerState) {
    try {
        if (isset($workerState->worker)) {
            $workerState->worker->terminate();
        }

        $basePath = $bootstrap($serverState);
        $workerState->worker = new Worker(
            new ApplicationFactory($basePath), $workerState->client
        );
        $workerState->worker->boot();
        $workerState->app = $workerState->worker->application();

        echo "Workers reloaded successfully." . PHP_EOL;
    } catch (Throwable $e) {
        echo "Error reloading workers: " . $e->getMessage() . PHP_EOL;
    }
};

if (function_exists('pcntl_signal') && defined('SIGUSR1') && defined('SIGTERM')) {
    pcntl_signal(SIGUSR1, $reloadApplication);
    pcntl_signal(SIGTERM, function () use ($socket, $server) {
        echo "Shutting down ReactPHP server..." . PHP_EOL;
        $socket->close();
        $server->close();
        exit(0);
    });
}

if (method_exists(Loop::class, 'addSignal') && defined('SIGUSR1') && defined('SIGTERM')) {
    Loop::addSignal(SIGUSR1, $reloadApplication);
    Loop::addSignal(SIGTERM, function () use ($socket, $server) {
        echo "Shutting down ReactPHP server..." . PHP_EOL;
        $socket->close();
        $server->close();
        Loop::stop();
    });
}

Loop::run();
